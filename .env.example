# CloudGuardian AI Environment Variables

# Service Ports & Database
PORT=5000
MONGO_URI=mongodb://localhost:27017/cloudguardian

# Service URLs (Local defaults)
ML_SERVICE_URL=http://localhost:8000
RECOVERY_SERVICE_URL=http://localhost:5002
BACKEND_URL=http://localhost:5000

# Simulator & Agent
SIM_HOST=localhost
SERVERS_FILE=../shared/servers.json
COLLECT_INTERVAL_MS=5000

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_USE_MOCK=false

# External APIs
ANTHROPIC_API_KEY=
